              "authentication"
            ]
          },
          {
            "group": "SKP",
            "pages": [
              "skp/overview",
              "skp/dashboard",
              "skp/progress",
              "skp/list"
            ]
          },
          {
            "group": "Kegiatan",
            "pages": [
              "kegiatan/overview",
              "kegiatan/monitoring",
              "kegiatan/calendar",
              "kegiatan/assignments"
            ]
          },
          {
            "group": "Documents & Contracts",
            "pages": [
              "documents/letters",
              "documents/spk-bast",
              "documents/contractual-monitoring"
            ]
          },
          {
            "group": "RKK DIPA",
            "pages": [
              "rkk-dipa/overview",
              "rkk-dipa/monitoring",
              "rkk-dipa/planning",
              "rkk-dipa/disbursement"
            ]
          },
          {
            "group": "Administration",
            "pages": [
              "admin/users",
              "admin/roles-permissions",
              "admin/metadata"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
