    "item": [
        {
            "name": "AI Service",
            "description": "\nController for proxying requests to Google's Generative Language API (Gemini).\nProvides a backend relay for frontend applications to securely access AI features.",
            "item": [
                {
                    "name": "Proxy request to Google's Generative Language API.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/ai\/generate",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/ai\/generate"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"prompt\":\"architecto\",\"systemInstruction\":\"architecto\",\"model\":\"architecto\"}"
                        },
                        "description": "Relays prompts and configurations to the Gemini API and returns the AI's response."
                    },
                    "response": []
                }
            ]
        },
