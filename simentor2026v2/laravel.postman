            "item": [
                {
                    "name": "Menampilkan daftar hari libur dengan pagination dan filtering.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/kantor\/holidays",
                            "query": [
                                {
                                    "key": "filter%5Bdeskripsi%5D",
                                    "value": "architecto",
                                    "description": "Filter berdasarkan deskripsi. Contoh: tahun baru",
                                    "disabled": false
                                },
                                {
                                    "key": "filter%5Byear%5D",
                                    "value": "16",
                                    "description": "Filter berdasarkan tahun. Contoh: 2024",
                                    "disabled": false
                                },
                                {
                                    "key": "filter%5Bsearch%5D",
                                    "value": "architecto",
                                    "description": "Pencarian global di deskripsi. Contoh: tahun",
                                    "disabled": false
                                },
                                {
                                    "key": "sort",
                                    "value": "architecto",
                                    "description": "Kolom untuk sorting (default: -tanggal). Contoh: -tanggal,deskripsi",
                                    "disabled": false
                                },
                                {
                                    "key": "per_page",
                                    "value": "16",
                                    "description": "Jumlah item per halaman (default: 15). Contoh: 10",
